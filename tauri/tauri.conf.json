{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Life Pixel",
  "identifier": "tech.lifepixel.desktop",
  "build": {
    "frontendDist": "../frontend/dist/app/browser",
    "devUrl": "http://localhost:4260",
    "beforeDevCommand": { "script": "npm start", "cwd": "../frontend", "wait": false },
    "beforeBuildCommand": { "script": "npm run build:app", "cwd": "../frontend" }
  },
  "app": {
    "windows": [
      {
        "title": "Life Pixel",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost blob:; worker-src 'self'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "deb", "rpm", "appimage"],
    "category": "GraphicsAndDesign",
    "license": "AGPL-3.0-only",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
