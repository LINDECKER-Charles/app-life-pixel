{
  "components": {
    "schemas": {
      "Health": {
        "description": "The server's health.",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus",
            "description": "Always `ok`: a server that cannot answer sends a problem."
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "HealthStatus": {
        "description": "The status of a healthy server.",
        "enum": [
          "ok"
        ],
        "type": "string"
      },
      "Problem": {
        "description": "An error, as RFC 9457 problem details with a stable code and its parameters, never a\nsentence: the interface translates `errors.<code>`.",
        "example": {
          "code": "quota.storage_exceeded",
          "params": {
            "limit": 100000000,
            "requested": 2000000,
            "used": 99000000
          },
          "status": 409,
          "type": "urn:life-pixel:problem:quota.storage_exceeded"
        },
        "properties": {
          "code": {
            "description": "The stable code, dot-separated `snake_case` segments, domain first.",
            "type": "string"
          },
          "params": {
            "additionalProperties": {},
            "description": "The parameters of the code's message, with camelCase keys.",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "status": {
            "description": "The HTTP status.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "type": {
            "description": "`urn:life-pixel:problem:<code>`.",
            "type": "string"
          }
        },
        "required": [
          "type",
          "status",
          "code",
          "params"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "type": "http"
      },
      "csrf": {
        "in": "header",
        "name": "X-CSRF-Token",
        "type": "apiKey"
      },
      "session": {
        "in": "cookie",
        "name": "__Host-lp_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "The Life Pixel server's public API.",
    "license": {
      "identifier": "AGPL-3.0-only",
      "name": "AGPL-3.0-only"
    },
    "title": "Life Pixel API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "The database answers"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The database does not answer: `service.unavailable`"
          }
        },
        "summary": "Whether the database answers within a second.",
        "tags": [
          "health"
        ]
      }
    }
  }
}
