{
  "name": "life-pixel-frontend",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "node tools/prebuild.mjs && node tools/copy-i18n.mjs && node tools/copy-design-assets.mjs && ng serve app --port 4260",
    "start:admin": "ng serve admin --port 4263",
    "build:app": "node tools/prebuild.mjs && node tools/copy-i18n.mjs && node tools/copy-design-assets.mjs && ng build app",
    "build:admin": "ng build admin",
    "build": "npm run build:app && npm run build:admin",
    "test:ci": "ng test app --watch=false && ng test shared --watch=false && ng test admin --watch=false",
    "test:engine": "node tools/prebuild.mjs && ng test app --configuration=engine --watch=false",
    "e2e": "playwright test --project=editor",
    "e2e:hosted": "playwright test --project=hosted",
    "e2e:visual": "playwright test --project=visual",
    "test:tools": "node --test \"tools/**/*.test.mjs\"",
    "lint": "ng lint && stylelint \"projects/**/*.scss\" && prettier --check .",
    "format": "prettier --write .",
    "i18n:check": "node tools/check-i18n.mjs",
    "i18n:check-bundle": "node tools/check-i18n-bundle.mjs",
    "api:generate": "node tools/generate-api.mjs"
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@ionic/angular": "^9.0.8",
    "@jsverse/transloco": "^8.4.0",
    "@jsverse/transloco-messageformat": "^8.4.0",
    "@life-pixel/player": "file:../player-js",
    "@messageformat/parser": "^5.2.0",
    "@tauri-apps/api": "^2.12.4",
    "marked": "^18.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@axe-core/playwright": "^4.14.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.13.6",
    "@vitest/browser-playwright": "^5.0.5",
    "angular-eslint": "22.6.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "ng-packagr": "^22.2.4",
    "openapi-typescript": "7.13.0",
    "otpauth": "^9.5.2",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "vite": "8.3.3"
  }
}
