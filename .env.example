# H0 — local stack
LP_POSTGRES_PASSWORD=local
LP_DB_PASSWORD=local
LPA_DB_PASSWORD=local
LP_TEST_DATABASE_URL=postgres://postgres:local@127.0.0.1:5460/postgres

# H3 — server: read from .env by `cargo run -p life-pixel-server` in development only. The keys
# below are public development keys, one repeated byte each: they protect nothing but the local
# stack. Every host generates its own, 64 hexadecimal characters each (`openssl rand -hex 32`).
LP_ENVIRONMENT=local
LP_HTTP_ADDR=127.0.0.1:8460
LP_METRICS_ADDR=127.0.0.1:8461
LP_ADMIN_API_ADDR=127.0.0.1:8462
LP_PUBLIC_URL=http://localhost:8460
LP_ALLOWED_ORIGINS=http://localhost:4260
LP_APP_DIR=frontend/dist/app/browser
LP_I18N_DIR=i18n
LP_DATABASE_URL=postgres://life_pixel:local@127.0.0.1:5460/life_pixel
LP_DATABASE_MAX_CONNECTIONS=10
LP_STORAGE_URL=s3://life-pixel-local
LP_S3_ENDPOINT=http://127.0.0.1:5461
LP_S3_REGION=us-east-1
LP_S3_ACCESS_KEY_ID=local
LP_S3_SECRET_ACCESS_KEY=local
LP_S3_PATH_STYLE=true
LP_SMTP_URL=smtp://127.0.0.1:5462
LP_MAIL_FROM="Life Pixel <no-reply@localhost>"
LP_SESSION_SECRET=0101010101010101010101010101010101010101010101010101010101010101
LP_EVENTS_SECRET=0202020202020202020202020202020202020202020202020202020202020202
LP_EXPORT_LINK_SECRET=0303030303030303030303030303030303030303030303030303030303030303
LP_ADMIN_API_SECRET=0404040404040404040404040404040404040404040404040404040404040404
LP_PLAN_FREE_STORAGE_BYTES=100000000
LP_PLAN_FREE_MCP_CALLS_PER_DAY=1000
LP_MIN_CLIENT_VERSIONS=web=0.0.0,desktop=0.0.0
LP_TRUSTED_PROXIES=
LP_MCP_SERVER_NAME=life-pixel-dev
LP_LEGAL_PUBLISHER="Life Pixel (local)"
LP_LEGAL_ADDRESS="Local address"
LP_LEGAL_CONTACT=contact@localhost
LP_LEGAL_DIRECTOR="Local director"
LP_LEGAL_HOST="Local host"
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
RUST_LOG=info

# H4 — stack tests: Mailpit's API, where `TestMailbox` finds the messages sent to its recipient.
LP_TEST_MAILPIT_URL=http://127.0.0.1:5463

# H11 — admin server: read from .env by `cargo run -p life-pixel-admin-server` in development
# only. Public development keys, as above; the monitoring sources and selectors stay empty
# locally, and the console says so.
LPA_ENVIRONMENT=local
LPA_HTTP_ADDR=127.0.0.1:8463
LPA_METRICS_ADDR=127.0.0.1:8464
LPA_PUBLIC_URL=http://localhost:8463
LPA_ALLOWED_ORIGINS=http://localhost:4263
LPA_APP_DIR=frontend/dist/admin/browser
LPA_I18N_DIR=i18n
LPA_DATABASE_URL=postgres://life_pixel_admin:local@127.0.0.1:5460/life_pixel_admin
LPA_SESSION_SECRET=0505050505050505050505050505050505050505050505050505050505050505
LPA_TOTP_KEY=0606060606060606060606060606060606060606060606060606060606060606
# Optional — the root admin, created at start when there is no admin at all: see
# .env.prod.example. Empty here: `create-admin` makes local admins.
LPA_ROOT_ADMIN_EMAIL=
LPA_ROOT_ADMIN_PASSWORD=
LPA_ROOT_ADMIN_TOTP_SECRET=
LPA_SERVER_ADMIN_API_URL=http://127.0.0.1:8462/internal/admin/v1
LPA_SERVER_ADMIN_API_SECRET=0404040404040404040404040404040404040404040404040404040404040404
LPA_TRUSTED_PROXIES=
LPA_ENVIRONMENTS=staging,production
LPA_VICTORIAMETRICS_URL=
LPA_VICTORIALOGS_URL=
LPA_ALERTMANAGER_URL=
LPA_GRAFANA_URL=
LPA_METRICS_SELECTOR_STAGING=
LPA_CONTAINERS_SELECTOR_STAGING=
LPA_LOGS_SELECTOR_STAGING=
LPA_METRICS_SELECTOR_PRODUCTION=
LPA_CONTAINERS_SELECTOR_PRODUCTION=
LPA_LOGS_SELECTOR_PRODUCTION=
LPA_ALERTS_FILTER=
