# Copy to .env next to compose.yaml, then replace every <…>. Secrets are 64 hexadecimal
# characters each: `openssl rand -hex 32`.

# The address the server's port 8080 is published on: loopback, behind a reverse proxy on the
# same host (README.md), or 0.0.0.0 to reach it from other machines, over plain HTTP.
LP_PUBLISH_ADDRESS=127.0.0.1

# The URL people open, as the reverse proxy serves it.
LP_PUBLIC_URL=https://<your domain>
# Other origins allowed to call the API, separated by commas; empty for none.
LP_ALLOWED_ORIGINS=
# The networks whose X-Forwarded-For is believed, such as the reverse proxy's, as CIDRs.
LP_TRUSTED_PROXIES=

# Postgres: the password of the life_pixel role, set once, when the volume is created.
LP_DB_PASSWORD=<database password>
LP_DATABASE_MAX_CONNECTIONS=10

# Mail: address verifications and password resets go through your SMTP server.
LP_SMTP_URL=smtps://<user>:<password>@<smtp host>:465
LP_MAIL_FROM="Life Pixel <no-reply@<your domain>>"

LP_SESSION_SECRET=<64 hexadecimal characters>
LP_EVENTS_SECRET=<64 hexadecimal characters>
LP_EXPORT_LINK_SECRET=<64 hexadecimal characters>
# Shared with the admin console, if you run it (README.md).
LP_ADMIN_API_SECRET=<64 hexadecimal characters>

# Every account's allowance.
LP_PLAN_FREE_STORAGE_BYTES=100000000
LP_PLAN_FREE_MCP_CALLS_PER_DAY=1000
LP_MIN_CLIENT_VERSIONS=web=0.0.0,desktop=0.0.0
# The name MCP clients show for this server.
LP_MCP_SERVER_NAME=life-pixel

# The legal notice of your instance: who publishes it and who hosts it.
LP_LEGAL_PUBLISHER="<publisher>"
LP_LEGAL_ADDRESS="<postal address>"
LP_LEGAL_CONTACT=<contact address>
LP_LEGAL_DIRECTOR="<publication director>"
LP_LEGAL_HOST="<hosting provider, with its address>"

RUST_LOG=info
