# Shared editor settings. rustfmt and Prettier have the last word on code layout; this file
# covers what they do not: encoding, line endings, final newline, indentation of other files.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{rs,toml}]
indent_size = 4

# Native Android project generated by Tauri.
[*.{java,kt,kts,gradle,xml}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
