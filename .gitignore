# Rust
debug/
target/
**/*.rs.bk
*.pdb

# Node and Angular
node_modules/
dist/
.angular/
coverage/
*.tsbuildinfo

# End-to-end test reports
playwright-report/
test-results/

# Android signing and local SDK paths — never versioned
local.properties
*.keystore
*.jks

# Environment files and secrets: only the *.example templates are versioned
.env
.env.*
!.env.example
!.env.*.example
/scripts/secrets.local.env

# Logs
*.log

# Editors and operating systems
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Local agent data
.claude/

# AGENTS.md is versioned here — it mirrors CLAUDE.md for the other coding agents — even where a
# global gitignore excludes it. A repository .gitignore takes precedence over core.excludesFile.
!AGENTS.md
