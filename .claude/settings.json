{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force-with-lease)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * dev)",
      "Bash(git push * *:dev)",
      "Bash(git push * test)",
      "Bash(git push * *:test)",
      "Bash(git push * main)",
      "Bash(git push * *:main)",
      "Bash(* --no-verify)",
      "Bash(* --no-verify *)",
      "Bash(git commit -n *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push * --force)",
      "PowerShell(git push * --force *)",
      "PowerShell(git push --force-with-lease *)",
      "PowerShell(git push * --force-with-lease)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)",
      "PowerShell(git push * dev)",
      "PowerShell(git push * *:dev)",
      "PowerShell(git push * test)",
      "PowerShell(git push * *:test)",
      "PowerShell(git push * main)",
      "PowerShell(git push * *:main)",
      "PowerShell(* --no-verify)",
      "PowerShell(* --no-verify *)",
      "PowerShell(git commit -n *)"
    ],
    "ask": [
      "Edit(/CLAUDE.md)",
      "Edit(/AGENTS.md)",
      "Edit(/.claude/settings.json)",
      "Edit(/.github/**)",
      "Edit(/clippy.toml)",
      "Edit(/deny.toml)",
      "Edit(/rustfmt.toml)",
      "Edit(/rust-toolchain.toml)",
      "Edit(/xtask/src/boundaries/**)",
      "Edit(/frontend/eslint.config.js)",
      "Edit(/frontend/stylelint.config.mjs)",
      "Edit(/frontend/.prettierrc.json)",
      "Edit(/scripts/ci/**)"
    ]
  }
}
