# The .env of production on the shared VPS, kept whole in the ENV_PROD secret: deploy.sh writes it
# to /opt/life-pixel-prod/.env, mode 600. Placeholders only: every <…> is replaced, and the real
# file is never committed. The listeners (LP_HTTP_ADDR, LP_METRICS_ADDR, LP_ADMIN_API_ADDR,
# LPA_HTTP_ADDR, LPA_METRICS_ADDR) and the folders (LP_APP_DIR, LP_I18N_DIR, LPA_APP_DIR,
# LPA_I18N_DIR) are the images' and never set here; compose.deploy.yaml sets
# OTEL_EXPORTER_OTLP_ENDPOINT, deploy.sh IMAGE_TAG. Secrets are 64 hexadecimal characters each
# (`openssl rand -hex 32`), their own on each host.

# Compose
COMPOSE_PROJECT_NAME=life-pixel-prod
CADDY_DOMAINS=lifepixel.tech
ADMIN_DOMAINS=admin.lifepixel.tech

# Postgres: the superuser's and the two roles' passwords, which docker/postgres/init.sh sets
# once, on an empty volume.
LP_POSTGRES_PASSWORD=<postgres superuser password>
LP_DB_PASSWORD=<life_pixel password>
LPA_DB_PASSWORD=<life_pixel_admin password>

# Server
LP_ENVIRONMENT=production
LP_PUBLIC_URL=https://lifepixel.tech
LP_ALLOWED_ORIGINS=
LP_DATABASE_URL=postgres://life_pixel:<life_pixel password>@postgres:5432/life_pixel
LP_DATABASE_MAX_CONNECTIONS=10
LP_STORAGE_URL=s3://<bucket>
LP_S3_ENDPOINT=https://s3.fr-par.scw.cloud
LP_S3_REGION=fr-par
LP_S3_ACCESS_KEY_ID=<access key id>
LP_S3_SECRET_ACCESS_KEY=<secret access key>
LP_S3_PATH_STYLE=false
LP_SMTP_URL=smtps://<user>:<password>@<smtp host>:465
LP_MAIL_FROM="Life Pixel <no-reply@lifepixel.tech>"
LP_SESSION_SECRET=<64 hexadecimal characters>
LP_EVENTS_SECRET=<64 hexadecimal characters>
LP_EXPORT_LINK_SECRET=<64 hexadecimal characters>
LP_ADMIN_API_SECRET=<64 hexadecimal characters, the same as LPA_SERVER_ADMIN_API_SECRET>
LP_PLAN_FREE_STORAGE_BYTES=100000000
LP_PLAN_FREE_MCP_CALLS_PER_DAY=1000
LP_MIN_CLIENT_VERSIONS=web=<version>,desktop=<version>
LP_TRUSTED_PROXIES=<the edge network's subnet, as a CIDR>
LP_MCP_SERVER_NAME=life-pixel
LP_LEGAL_PUBLISHER="<publisher>"
LP_LEGAL_ADDRESS="<postal address>"
LP_LEGAL_CONTACT=<contact address>
LP_LEGAL_DIRECTOR="<publication director>"
LP_LEGAL_HOST="<hosting provider, with its address>"
RUST_LOG=info

# Admin server
LPA_ENVIRONMENT=production
LPA_PUBLIC_URL=https://admin.lifepixel.tech
LPA_ALLOWED_ORIGINS=
LPA_DATABASE_URL=postgres://life_pixel_admin:<life_pixel_admin password>@postgres:5432/life_pixel_admin
LPA_SESSION_SECRET=<64 hexadecimal characters>
LPA_TOTP_KEY=<64 hexadecimal characters>
LPA_SERVER_ADMIN_API_URL=http://server:9091/internal/admin/v1
LPA_SERVER_ADMIN_API_SECRET=<64 hexadecimal characters, the same as LP_ADMIN_API_SECRET>
LPA_TRUSTED_PROXIES=<the edge network's subnet, as a CIDR>
LPA_ENVIRONMENTS=staging,production
LPA_VICTORIAMETRICS_URL=<VictoriaMetrics URL on the observability network>
LPA_VICTORIALOGS_URL=<VictoriaLogs URL on the observability network>
LPA_ALERTMANAGER_URL=<Alertmanager URL on the observability network>
LPA_GRAFANA_URL=<Grafana's public URL>
LPA_GRAFANA_LOGS_DATASOURCE=<Grafana logs datasource uid>
LPA_GRAFANA_TRACES_DATASOURCE=<Grafana traces datasource uid>
LPA_METRICS_SELECTOR_STAGING=<metrics selector of staging>
LPA_CONTAINERS_SELECTOR_STAGING=<containers selector of staging>
LPA_LOGS_SELECTOR_STAGING=<logs selector of staging>
LPA_METRICS_SELECTOR_PRODUCTION=<metrics selector of production>
LPA_CONTAINERS_SELECTOR_PRODUCTION=<containers selector of production>
LPA_LOGS_SELECTOR_PRODUCTION=<logs selector of production>
LPA_ALERTS_FILTER=<Alertmanager matchers, {ENV} for the environment>

# H15 — backups, production only: the `backup` profile's services (operations.md, "H15 —
# Backups").
COMPOSE_PROFILES=backup
BACKUP_TIME=03:15
BACKUP_DATABASES=life_pixel life_pixel_admin
PGHOST=postgres
PGUSER=postgres
PGPASSWORD=<postgres superuser password>
RCLONE_CONFIG_BACKUPS3_TYPE=s3
RCLONE_CONFIG_BACKUPS3_PROVIDER=Scaleway
RCLONE_CONFIG_BACKUPS3_ENDPOINT=https://s3.nl-ams.scw.cloud
RCLONE_CONFIG_BACKUPS3_REGION=nl-ams
RCLONE_CONFIG_BACKUPS3_ACCESS_KEY_ID=<write-only access key id>
RCLONE_CONFIG_BACKUPS3_SECRET_ACCESS_KEY=<write-only secret access key>
RCLONE_CONFIG_BACKUPCRYPT_TYPE=crypt
RCLONE_CONFIG_BACKUPCRYPT_REMOTE=backups3:<bucket>/production
RCLONE_CONFIG_BACKUPCRYPT_FILENAME_ENCRYPTION=off
RCLONE_CONFIG_BACKUPCRYPT_PASSWORD=<crypt password, obscured by rclone obscure>
RCLONE_CONFIG_BACKUPCRYPT_PASSWORD2=<crypt salt, obscured by rclone obscure>
